# Copy these into Streamlit Community Cloud -> App -> Settings -> Secrets.
# NEVER commit a real secrets.toml (it is gitignored).
OPENAI_API_KEY = "sk-..."          # use a dedicated key from a budget-capped OpenAI project
# DEMO_ACCESS_CODE = "choose-a-code" # optional: leave unset to let anyone try the live console
DEMO_LIVE_ENABLED = "true"         # set "false" to kill live drafting instantly
DEMO_SESSION_LIMIT = "5"           # drafts per browser session
DEMO_COOLDOWN_SECONDS = "10"       # seconds between drafts
DEMO_CLIENT_DAILY_LIMIT = "10"     # drafts per IP per UTC day
DEMO_DAILY_LIMIT = "100"           # drafts per UTC day, all visitors
DEMO_MAX_INPUT_CHARS = "500"
